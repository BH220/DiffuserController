<UserControl
    x:Class="DiffuserControllerNew.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="clr-namespace:DiffuserControllerNew.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiffuserControllerNew.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:DiffuserControllerNew.Converter"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Background="White"
    mc:Ignorable="d">
    <UserControl.Resources>
        <uc:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>
    <Border Padding="50,30,50,50">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="35" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Style="{StaticResource LeftTitle}"
                Text="대상 USB" />
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Grid.Column="0"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding UsbItems}"
                    SelectedIndex="{Binding UsbSelectedIndex, Mode=TwoWay}"
                    SelectionChanged="ComboBox_SelectionChanged"
                    Style="{StaticResource ComboGeneral}" />
                <ui:Button
                    Grid.Column="1"
                    Width="80"
                    Height="30"
                    Margin="10,0,0,0"
                    Command="{Binding SearchCommand}"
                    Content="새로고침"
                    Style="{StaticResource BtnFunction}" />
            </Grid>
            <ui:TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource LeftTitle}"
                Text="동작 구분" />
            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Orientation="Horizontal"
                Style="{StaticResource RadioActionType}">
                <RadioButton
                    Margin="0,0,0,0"
                    Content="Interval"
                    GroupName="ActionType"
                    IsChecked="{Binding SelectedActionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static cm:ActionType.Interval}}"
                    Style="{StaticResource RadioButton}" />

                <RadioButton
                    Margin="10,0,0,0"
                    Content="Schedule"
                    GroupName="ActionType"
                    IsChecked="{Binding SelectedActionType, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static cm:ActionType.Schedule}}"
                    Style="{StaticResource RadioButton}" />
            </StackPanel>
            <StackPanel
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal">
                <Grid Visibility="{Binding VisibleInterval}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource GridTitleLeft}"
                        Text="시작 시간" />

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <ComboBox
                            ItemsSource="{Binding DtStartH}"
                            SelectedItem="{Binding SelectedDtStartH, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                        <ui:TextBlock Style="{StaticResource Content}" Text=" : " />
                        <ComboBox
                            ItemsSource="{Binding DtStartM}"
                            SelectedItem="{Binding SelectedDtStartM, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                    </StackPanel>
                    <ui:TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource GridTitleLeft}"
                        Text="종료 시간" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <ComboBox
                            ItemsSource="{Binding DtEndH}"
                            SelectedItem="{Binding SelectedDtEndH, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                        <ui:TextBlock Style="{StaticResource Content}" Text=" : " />
                        <ComboBox
                            ItemsSource="{Binding DtEndM}"
                            SelectedItem="{Binding SelectedDtEndM, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                    </StackPanel>
                    <ui:TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource GridTitleLeft}"
                        Text="간격" />

                    <StackPanel
                        Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <ComboBox
                            ItemsSource="{Binding DtTermH}"
                            SelectedItem="{Binding SelectedDtTermH, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                        <ui:TextBlock Style="{StaticResource Content}" Text=" : " />
                        <ComboBox
                            ItemsSource="{Binding DtTermM}"
                            SelectedItem="{Binding SelectedDtTermM, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                        <ui:TextBlock Style="{StaticResource Content}" Text=" : " />
                        <ComboBox
                            ItemsSource="{Binding DtTermS}"
                            SelectedItem="{Binding SelectedDtTermS, Mode=TwoWay}"
                            SelectionChanged="ComboBox_SelectionChanged"
                            Style="{StaticResource ComboGeneral}" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding VisibleSchedule}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        Grid.Column="0"
                        Style="{StaticResource GridTitleLeft}"
                        Text="시작 시간" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <Border BorderBrush="#ABADB3" BorderThickness="1">
                            <ListView
                                Width="80"
                                Height="113"
                                ItemsSource="{Binding ListItems}"
                                SelectedItem="{Binding SelectedListItem, Mode=TwoWay}"
                                Style="{StaticResource ListView}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" Orientation="Vertical">
                            <ui:Button
                                Width="80"
                                Height="30"
                                Margin="0,0,0,10"
                                Command="{Binding AddCommand}"
                                Content="추가"
                                Style="{StaticResource BtnFunctionBlue}" />
                            <ui:Button
                                Width="80"
                                Height="30"
                                Margin="0,0,0,10"
                                Command="{Binding DelCommand}"
                                Content="삭제"
                                Style="{StaticResource BtnFunction}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <ui:TextBlock
                Grid.Row="6"
                Grid.Column="0"
                Style="{StaticResource GridTitleLeft}"
                Text="분사 유지 시간" />
            <StackPanel
                Grid.Row="6"
                Grid.Column="1"
                Orientation="Horizontal">
                <ComboBox
                    ItemsSource="{Binding DtTermInterval}"
                    SelectedItem="{Binding SelectedDtTermInterval, Mode=TwoWay}"
                    SelectionChanged="ComboBox_SelectionChanged"
                    Style="{StaticResource ComboGeneral}" />
                <ui:TextBlock Style="{StaticResource Content}" Text=" 초" />
            </StackPanel>
            <StackPanel
                Grid.Row="8"
                Grid.Column="1"
                Orientation="Horizontal">
                <ui:Button
                    Width="80"
                    Height="30"
                    Command="{Binding RunCommand}"
                    Content="동작"
                    IsEnabled="{Binding BtnRunEnabled}"
                    Style="{StaticResource BtnFunctionBlue}" />
                <ui:Button
                    Width="80"
                    Height="30"
                    Command="{Binding StopCommand}"
                    Content="중지"
                    IsEnabled="{Binding BtnStopEnabled}"
                    Style="{StaticResource BtnFunction}" />
            </StackPanel>
            <StackPanel
                Grid.Row="10"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal">
                <ui:Button
                    Width="80"
                    Height="30"
                    Command="{Binding OnCommand}"
                    Content="강제 ON"
                    Style="{StaticResource BtnFunctionBlue}" />
                <ui:Button
                    Width="80"
                    Height="30"
                    Command="{Binding OffCommand}"
                    Content="강제 OFF"
                    Style="{StaticResource BtnFunction}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
