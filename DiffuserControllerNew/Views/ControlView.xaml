<UserControl
    x:Class="DiffuserControllerNew.Views.ControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiffuserControllerNew.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Background="White"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource LeftTitle}"
            Text="대상 USB" />
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal">
            <ComboBox Width="200" />
            <ui:Button Content="새로고침" Style="{StaticResource BtnFunction}" />
        </StackPanel>
        <ui:TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource LeftTitle}"
            Text="동작 구분" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Orientation="Horizontal">
            <RadioButton Content="Interval" Style="{StaticResource RadioButton}" />
            <RadioButton Content="Schedule" Style="{StaticResource RadioButton}" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource GridTitleLeft}"
                    Text="시작 시간" />

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    <ui:TextBlock Style="{StaticResource Content}" Text=":" />
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                </StackPanel>
                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource GridTitleLeft}"
                    Text="종료 시간" />

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    <ui:TextBlock Style="{StaticResource Content}" Text=":" />
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                </StackPanel>
                <ui:TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource GridTitleLeft}"
                    Text="간격" />

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    <ui:TextBlock Style="{StaticResource Content}" Text=":" />
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    <ui:TextBlock Style="{StaticResource Content}" Text=":" />
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                </StackPanel>
                <ui:TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource GridTitleLeft}"
                    Text="분사 유지 시간" />

                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    <ui:TextBlock Style="{StaticResource Content}" Text="초" />
                </StackPanel>
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:Button Content="설정" Style="{StaticResource BtnFunctionBlue}" />
                    <ui:Button Content="설정" Style="{StaticResource BtnFunctionBlue}" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource GridTitleLeft}"
                    Text="시작 시간" />

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal">

                    <ui:ListView Width="80" Height="150" />
                    <StackPanel Orientation="Vertical">
                        <ui:Button Content="추가" Style="{StaticResource BtnFunctionBlue}" />
                        <ui:Button Content="추가" Style="{StaticResource BtnFunctionBlue}" />
                    </StackPanel>
                </StackPanel>
                <ui:TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource GridTitleLeft}"
                    Text="분사 유지 시간" />

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    <ui:TextBlock Style="{StaticResource Content}" Text="초" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <ui:Button Content="설정" Style="{StaticResource BtnFunctionBlue}" />
                    <ui:Button Content="설정" Style="{StaticResource BtnFunctionBlue}" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal">
            <ui:Button Content="새로고침" Style="{StaticResource BtnFunction}" />
            <ui:Button Content="새로고침" Style="{StaticResource BtnFunction}" />
        </StackPanel>
    </Grid>
</UserControl>
