<UserControl
    x:Class="DiffuserControllerNew.Views.IgnoreDateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DiffuserControllerNew.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:Background="White"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Style="{StaticResource NotiTitle}"
            Text="이 탭을 통해 등록된 날짜에는 스케줄링이 동작하지 않습니다." />
        <StackPanel Grid.Row="1" Grid.Column="0">
            <GroupBox Header=" 개별 저장 처리 " Style="{StaticResource GroupBox}">

                <StackPanel Orientation="Vertical">
                    <Calendar />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource LeftSubTitle}"
                            Text="선택 날짜" />
                        <ui:TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource SelectedDate}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource LeftSubTitle}"
                            Text="내용" />
                        <ui:TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource SelectedContent}" />
                        <ui:Button
                            Grid.Row="2"
                            Grid.Column="0"
                            Content="연속 적용"
                            Style="{StaticResource BtnFunction}" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <ui:Button Content="적용" Style="{StaticResource BtnFunctionBlue}" />
                            <ui:Button Content="삭제" Style="{StaticResource BtnFunction}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header=" 일괄 저장 처리 " Style="{StaticResource GroupBox}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBlock Style="{StaticResource LeftSubTitle}" Text="기준년도:" />
                        <ui:NumberBox Width="80" Style="{StaticResource NumberOnly}" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="90"
                            Content="적용"
                            Style="{StaticResource BtnFunctionBlue}" />
                        <ui:Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="90"
                            Content="적용"
                            Style="{StaticResource BtnFunctionBlue}" />

                        <ui:Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="90"
                            Content="적용"
                            Style="{StaticResource BtnFunctionBlue}" />
                    </Grid>

                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Orientation="Vertical">
            <ui:Button Content="새로고침" Style="{StaticResource BtnFunction}" />

            <ui:DataGrid
                Grid.Row="0"
                AutoGenerateColumns="False"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="False"
                CanUserResizeRows="False"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{StaticResource DataGridHeader}"
                GridLinesVisibility="None"
                IsReadOnly="True"
                ItemsSource="{Binding UserCollection}"
                RowHeaderWidth="0"
                RowHeight="32"
                RowStyle="{StaticResource DataGridRow}"
                SelectionMode="Single"
                SelectionUnit="Cell">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        Width="25*"
                        Binding="{Binding name}"
                        ElementStyle="{StaticResource CellStyle}"
                        Header="NAME" />
                    <DataGridTextColumn
                        Width="22*"
                        Binding="{Binding id}"
                        ElementStyle="{StaticResource CellStyle}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="25*"
                        Binding="{Binding email}"
                        ElementStyle="{StaticResource CellStyle}"
                        Header="EMAIL" />
                    <DataGridTextColumn
                        Width="15*"
                        MaxWidth="100"
                        ElementStyle="{StaticResource CellStyle}"
                        Header="USER TYPE" />

                    <DataGridTemplateColumn
                        Width="13*"
                        MaxWidth="65"
                        Header="STATUS">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{Binding status, Converter={StaticResource StatusColorConverter}}"
                                    Text="{Binding status, Converter={StaticResource StatusTypeConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </ui:DataGrid.Columns>
            </ui:DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
